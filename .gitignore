# Everything personal. If you ever put this on a remote, it must be a private one, and these
# stay out of it regardless.
jobhunt.db
jobhunt.db.*
config/profile.yaml
config/seed.yaml
config/boards.yaml
# Backup copies of the above. config/profile.yaml.bak reached the remote in a05335b carrying a
# name, email, phone, LinkedIn URL, resume_summary and the situation block, because the
# patterns above match the exact filenames and nothing matched a suffixed copy. Write backups
# outside the repo instead; these patterns are the backstop.
config/*.bak
config/*.bak-*
config/*.orig
*~
outbox/
digest/
logs/
# Your actual resume, and the per-req tailored versions generated from it.
config/resume.md
tailored/
# Generated by contacts.py, and personal once you fill it in: recruiter names, addresses and
# who you contacted when. Regenerate it with `python3 contacts.py --write`.
contacts.md
__pycache__/
*.pyc
.pytest_cache/
# Agent working notes: plans, reviews, verification logs and task reports. Useful while a piece
# of work is in flight and noise afterwards, and they quote freely from the gitignored config
# and database, so they stay out of history.
.agents/
# Scratch worktrees, e.g. the one the quality pass ran in. Created with
# `git worktree add .worktrees/<name>` and removed with `git worktree remove`.
.worktrees/
